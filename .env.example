ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Postgres credentials — read by docker-compose.yml to initialize the
# container, and embedded in DATABASE_URL below for the app/asyncpg (which
# needs the full connection URL, not the parts separately). If you change
# these, update DATABASE_URL to match.
POSTGRES_USER=substack_brain
POSTGRES_PASSWORD=substack_brain_pw
POSTGRES_DB=substack_brain
DATABASE_URL=postgresql+asyncpg://substack_brain:substack_brain_pw@localhost:5433/substack_brain

INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288
LAB_PORT=8000
USER_AGENT=substack-brain/0.1 (+https://github.com/neural-maze/substack-brain-course)

# Chunking — max characters per passage, and how many characters repeat
# between consecutive passages (see docs/week-1.md Step 6 for why overlap
# matters). Re-ingest existing articles after changing these; passages
# already persisted keep their old boundaries.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# How many of a feed's most recent entries add-publication fans out to
# ingest-article. Deliberately small for week 1 ("one newsletter, five
# articles"). Unused from week 2 on: backfill-publication takes the whole feed.
DISCOVERY_LIMIT=5

# Week 2 flow control for ingest-article (see docs/week-2.md).
# CONCURRENCY_PER_PUBLICATION: articles from the same publication in flight at
# once. INGEST_RUNS_PER_MINUTE: run starts per minute across all publications,
# roughly one OpenAI embedding request each. For the queue-jump demo, set them
# to 1 and 10 so the queue lasts long enough to watch.
CONCURRENCY_PER_PUBLICATION=3
INGEST_RUNS_PER_MINUTE=50
